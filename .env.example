# 应用配置
APP_NAME=Chat Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# 服务配置
HOST=0.0.0.0
PORT=9095

# user-service 对接（JWT 消费方，认证协议对齐 mservice-fastapi-user）
# user-service 的基础 URL，用于拉取 JWKS 公钥（Docker 网络内用服务名，本地用 localhost）
USER_SERVICE_URL=http://localhost:8000
# JWKS 缓存 TTL（秒），到期后强制从 user-service 刷新；kid 未命中时也会立即刷新
JWKS_CACHE_TTL_SECONDS=3600
# JWT 签名算法（与 user-service 一致）
ALGORITHM=RS256

# 超级用户白名单（三重 AND 校验，缺一不可）：
# 1. JWT payload 的 role == "superuser"；
# 2. username（sub）在 SUPERUSER_USERNAMES 中；
# 3. user_id 在 SUPERUSER_USER_IDS 中。
# 无兜底：任意一项不满足即拒绝管理接口（403）。
# 部署时请将 user_id 改为 user-service 中实际 superuser 的 ID。
SUPERUSER_USERNAMES=["superuser"]
SUPERUSER_USER_IDS=[1]

# 服务名白名单：非 superuser 的请求必须携带 service_name 且命中本白名单，否则 403
# （superuser 三重 AND 判定通过后不受此限制）
ALLOWED_SERVICE_NAMES=["default"]

# Redis 配置（redis.asyncio）：
# 外部 Redis 接入——直接配置 Redis 提供方给出的连接 URL（云 Redis / 自建实例均可），
# 服务不内置 Redis 镜像，Docker 部署时同样通过 URL 连接外部实例。
REDIS_URL=redis://localhost:6379/0
# Redis Key 统一前缀，避免多服务共用实例时冲突
REDIS_PREFIX=chat_service
REDIS_DECODE_RESPONSES=True

# PydanticAI 配置（DeepSeek / OpenAI 兼容）：
# - AI_PROVIDER=deepseek：DeepSeek 官方端点（api.deepseek.com），无需 AI_BASE_URL
# - AI_PROVIDER=openai：任意 OpenAI 兼容接口，AI_BASE_URL 指向网关/代理地址
# - AI_API_KEY 为空时回退 DEEPSEEK_API_KEY（deepseek 模式）或 OPENAI_API_KEY（openai 模式）
# - 模型与 Key 均未配置时 AI 端点返回 503
AI_PROVIDER=deepseek
AI_MODEL_NAME=deepseek-chat
AI_API_KEY=
AI_BASE_URL=
AI_SYSTEM_PROMPT=你是 Chat Service 的智能助手，请用简洁中文回答用户问题。
AI_REQUEST_TIMEOUT_SECONDS=60

# Tool 配置基础设施：控制注入 Agent 的 tool 名单
# ["*"] 启用全部已注册 tool（默认）；["name_a","name_b"] 仅启用名单内；[] 全部禁用
AI_ENABLED_TOOLS=["*"]
# 需审批 Tool 的 taskid 暂存 TTL（秒）：审批请求在期限内有效，超时自动作废（默认 300=5min）
AI_APPROVAL_TTL_SECONDS=300

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/chat_service.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS 配置
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:9095"]

# 日志操作类型（LogProxy 拦截的方法名白名单，预留聊天领域操作）
LOG_OPERATIONS=["conversation_create","conversation_update","conversation_delete","message_send","message_update","message_delete","message_read"]
